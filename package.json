{
  "name": "letterlock",
  "version": "1.0.0",
  "private": true,
  "description": "Letterlock word game - web + Android (Capacitor)",
  "scripts": {
    "build:web": "bash scripts/build-www.sh",
    "sync": "npm run build:web && npx cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
